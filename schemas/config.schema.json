{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "preset": {
      "default": "coding",
      "type": "string",
      "enum": ["coding", "research"]
    },
    "participants": {
      "minItems": 2,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      }
    },
    "maxRounds": {
      "default": 4,
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "maxMessages": {
      "default": 24,
      "type": "integer",
      "minimum": 4,
      "maximum": 100
    },
    "deadlineMinutes": {
      "default": 30,
      "type": "number",
      "minimum": 0.01,
      "maximum": 240
    },
    "checks": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "minItems": 1,
        "maxItems": 30,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": ["participants"],
  "additionalProperties": false
}
