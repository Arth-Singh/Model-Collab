{
  "name": "@arth-singh/model-collab",
  "version": "0.2.0",
  "description": "Run Codex and Claude Code together in your terminal",
  "type": "module",
  "bin": {
    "model-collab": "bin/model-collab.js"
  },
  "exports": {
    ".": "./src/core.js"
  },
  "files": [
    "bin",
    "src",
    "prompts",
    "schemas",
    "docs",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "scripts/check.js"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arth-Singh/Model-Collab.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "3.9.8"
  }
}
