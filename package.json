{
  "name": "@arth-singh/model-collab",
  "version": "0.5.0",
  "description": "A swarm of Claude Code and Codex agents that divide a goal among themselves over a shared chat and integrate it on one Git branch",
  "type": "module",
  "bin": {
    "model-collab": "bin/model-collab.js"
  },
  "exports": {
    ".": "./src/core.js"
  },
  "files": [
    "bin",
    "src",
    "prompts",
    "schemas",
    "docs",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "scripts/check.js",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arth-Singh/Model-Collab.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "3.9.8"
  },
  "homepage": "https://github.com/Arth-Singh/Model-Collab#readme",
  "bugs": {
    "url": "https://github.com/Arth-Singh/Model-Collab/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "multi-agent",
    "agent-swarm",
    "swarmchat",
    "mcp",
    "llm",
    "agents"
  ],
  "author": "Arth Singh"
}
